# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# QA harness output (screenshots + report, regenerated by `npm run qa`)
scripts/.qa-shots
scripts/.shots
scripts/.slices.mjs

# Photos uploaded through the admin in local development
data/uploads
data/inventory.backup.json

# Studio pipeline intermediates (regenerated by scripts/studio.py)
data/photos/cut
scripts/cutout/cutout
data/.inventory.e2e-snapshot.json
.claude/launch.json
